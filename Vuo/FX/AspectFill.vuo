/**
 * @file
 * @brief AspectFill - Fill canvas with input image and blurred background
 *
 * Published Inputs:
 *   image         (VuoImage)
 *   time          (VuoReal)
 *   canvasWidth   (VuoInteger)
 *   canvasHeight  (VuoInteger)
 *   blurRadius    (VuoReal, 0..200)
 *
 * Published Outputs:
 *   outputImage   (VuoImage)
 *
 * Install: ~/Library/Application Support/VDMX/VuoFX/
 *
 * @copyright Copyright © 2026 9c5s
 * @license MIT
 */

digraph G
{
ResizeFill [type="vuo.image.resize" version="1.1.3" label="Resize Fill|<refresh>refresh\l|<image>image\l|<sizingMode>sizingMode\l|<width>width\l|<height>height\l|<resizedImage>resizedImage\r" pos="450,80" _sizingMode="\"fill\"" _width="1920" _height="1080"];
ResizeFit [type="vuo.image.resize" version="1.1.3" label="Resize Fit|<refresh>refresh\l|<image>image\l|<sizingMode>sizingMode\l|<width>width\l|<height>height\l|<resizedImage>resizedImage\r" pos="450,400" _sizingMode="\"fit\"" _width="1920" _height="1080"];
BlurImage [type="vuo.image.blur" version="1.4.1" label="Blur Image|<refresh>refresh\l|<image>image\l|<mask>mask\l|<shape>shape\l|<radius>radius\l|<expandBounds>expandBounds\l|<quality>quality\l|<blurredImage>blurredImage\r" pos="700,80" _shape="\"linear\"" _radius="30.0" _expandBounds="false" _quality="1.0"];
ShareBlurRadius [type="vuo.data.share.VuoReal" version="1.0.0" label="Share Blur Radius|<refresh>refresh\l|<value>value\l|<sameValue>sameValue\r" pos="450,200"];
ShareCanvasWidth [type="vuo.data.share.VuoInteger" version="1.0.0" label="Share Canvas Width|<refresh>refresh\l|<value>value\l|<sameValue>sameValue\r" pos="200,260"];
ShareCanvasHeight [type="vuo.data.share.VuoInteger" version="1.0.0" label="Share Canvas Height|<refresh>refresh\l|<value>value\l|<sameValue>sameValue\r" pos="200,320"];
MakeBgLayer [type="vuo.layer.make.scaled" version="3.1.0" label="Make Bg Layer|<refresh>refresh\l|<image>image\l|<anchor>anchor\l|<center>center\l|<rotation>rotation\l|<width>width\l|<fixed>fixed\l|<opacity>opacity\l|<layer>layer\r" pos="950,80" _anchor="{\"horizontalAlignment\":\"center\",\"verticalAlignment\":\"center\"}" _center="{\"x\":0.0,\"y\":0.0}" _rotation="0.0" _width="2.0" _fixed="\"horizontal\"" _opacity="1.0"];
MakeFgLayer [type="vuo.layer.make.scaled" version="3.1.0" label="Make Fg Layer|<refresh>refresh\l|<image>image\l|<anchor>anchor\l|<center>center\l|<rotation>rotation\l|<width>width\l|<fixed>fixed\l|<opacity>opacity\l|<layer>layer\r" pos="950,400" _anchor="{\"horizontalAlignment\":\"center\",\"verticalAlignment\":\"center\"}" _center="{\"x\":0.0,\"y\":0.0}" _rotation="0.0" _width="2.0" _fixed="\"horizontal\"" _opacity="1.0"];
MakeList [type="vuo.list.make.2.VuoLayer" version="2.0.0" label="Make List|<refresh>refresh\l|<1>1\l|<2>2\l|<list>list\r" pos="1200,240"];
RenderToImage [type="vuo.layer.render.image2" version="2.0.0" label="Render Layers to Image|<refresh>refresh\l|<layers>layers\l|<width>width\l|<height>height\l|<colorDepth>colorDepth\l|<multisampling>multisampling\l|<image>image\r" pos="1450,240" _width="1920" _height="1080" _colorDepth="\"8bpc\"" _multisampling="\"4\""];
PublishedInputs [type="vuo.in" label="PublishedInputs|<image>image\r|<time>time\r|<canvasWidth>canvasWidth\r|<canvasHeight>canvasHeight\r|<blurRadius>blurRadius\r" _image_type="VuoImage" _time_type="VuoReal" _canvasWidth_type="VuoInteger" _canvasWidth="1920" _canvasWidth_suggestedMin="1" _canvasWidth_suggestedMax="4096" _canvasWidth_suggestedStep="256" _canvasHeight_type="VuoInteger" _canvasHeight="1080" _canvasHeight_suggestedMin="1" _canvasHeight_suggestedMax="4096" _canvasHeight_suggestedStep="256" _blurRadius_type="VuoReal" _blurRadius="30.000000" _blurRadius_suggestedMin="0.000000" _blurRadius_suggestedMax="200.000000" _blurRadius_suggestedStep="1.000000"];
PublishedOutputs [type="vuo.out" label="PublishedOutputs|<outputImage>outputImage\l" _outputImage_type="VuoImage"];

PublishedInputs:image -> ResizeFill:image;
PublishedInputs:image -> ResizeFit:image;
PublishedInputs:canvasWidth -> ShareCanvasWidth:value;
PublishedInputs:canvasHeight -> ShareCanvasHeight:value;
PublishedInputs:blurRadius -> ShareBlurRadius:value;

ShareCanvasWidth:sameValue -> ResizeFill:width;
ShareCanvasWidth:sameValue -> ResizeFit:width;
ShareCanvasWidth:sameValue -> RenderToImage:width;
ShareCanvasHeight:sameValue -> ResizeFill:height;
ShareCanvasHeight:sameValue -> ResizeFit:height;
ShareCanvasHeight:sameValue -> RenderToImage:height;
ShareBlurRadius:sameValue -> BlurImage:radius;

ResizeFill:resizedImage -> BlurImage:image;
ResizeFit:resizedImage -> MakeFgLayer:image;
BlurImage:blurredImage -> MakeBgLayer:image;
MakeBgLayer:layer -> MakeList:1;
MakeFgLayer:layer -> MakeList:2;
MakeList:list -> RenderToImage:layers;
RenderToImage:image -> PublishedOutputs:outputImage;
}
